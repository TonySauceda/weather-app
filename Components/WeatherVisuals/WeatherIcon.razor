<svg class="weather-icon" viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Summary)
    {
        case "Soleado":
            <circle class="sun" cx="48" cy="48" r="19" />
            <path class="rays" d="M48 12v9m0 54v9M12 48h9m54 0h9M23 23l7 7m36 36 7 7M23 73l7-7m36-36 7-7" />
            break;
        case "Parcialmente nublado":
            <circle class="sun" cx="36" cy="34" r="16" />
            <path class="rays" d="M36 8v5M10 34h5m3-18 4 4m33-4-4 4" />
            <path class="cloud" d="M29 73a15 15 0 0 1-2-30 22 22 0 0 1 42 5 13 13 0 1 1 5 25Z" />
