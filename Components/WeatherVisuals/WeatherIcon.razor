        case "Lluvioso":
            <path class="cloud" d="M23 57a14 14 0 0 1-1-28 23 23 0 0 1 43 5 12 12 0 1 1 8 23Z" />
            <path class="rain" d="m30 67-5 12m23-12-5 12m23-12-5 12" />
