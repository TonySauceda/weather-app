        case "Con brisa":
            <path class="wind" d="M12 35h46c17 0 17-22 4-22-7 0-10 5-10 9M8 49h66c17 0 17 23 3 23-6 0-9-4-9-8M18 63h22c15 0 15 21 2 21-5 0-8-3-8-7" />
            break;
        case "Nublado":
            <path class="cloud-back" d="M34 41a13 13 0 0 1 5-24 20 20 0 0 1 36 10 12 12 0 0 1 2 24H59" />
            <path class="cloud" d="M22 77a15 15 0 0 1-1-30 22 22 0 0 1 42 5 13 13 0 1 1 7 25Z" />
            break;
        default:
            <circle cx="48" cy="48" r="26" />
            <path d="M40 39a8 8 0 1 1 12 7c-4 2-4 5-4 7m0 9h.01" />
            break;
    }
</svg>
