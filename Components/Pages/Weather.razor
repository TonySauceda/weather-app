@page "/"
@page "/weather"
@rendermode InteractiveServer
@attribute [StreamRendering]
@using weather_app.Components.WeatherVisuals

<PageTitle>Pronóstico del clima</PageTitle>

<section class="weather-page">
    <header class="weather-page__header">
        <p class="weather-page__eyebrow">Pronóstico del clima</p>
    </header>

    <div class="weather-search-container">
        <EditForm class="weather-search" Model="search" OnValidSubmit="SearchAsync">
            <DataAnnotationsValidator />
            <div class="weather-search__field">
                <label for="city">Ciudad</label>
                <div class="weather-search__control">
                    <svg class="location-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                        <path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z" />
                        <circle cx="12" cy="10" r="2.5" />
                    </svg>
                    <InputText id="city" class="weather-search__input" @bind-Value="search.City" placeholder="Busca una ciudad…" autocomplete="address-level2" />
                </div>
                <ValidationMessage For="@(() => search.City)" />
            </div>
            <button class="weather-search__button" type="submit" disabled="@isLoading">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
                @(isLoading ? "Consultando..." : "Buscar")
            </button>
        </EditForm>
    </div>

    <div class="temperature-unit-toggle-container">
        <div class="temperature-unit-toggle" role="group" aria-label="Unidad de temperatura">
            <button class="@(isFahrenheit ? string.Empty : "temperature-unit-toggle__button--selected")" type="button" @onclick="() => isFahrenheit = false">°C</button>
            <button class="@(isFahrenheit ? "temperature-unit-toggle__button--selected" : string.Empty)" type="button" @onclick="() => isFahrenheit = true">°F</button>
        </div>
    </div>

    @if (isLoading && forecast is null)
    {
        <p class="weather-state" role="status">Cargando pronóstico...</p>
    }
    else if (errorMessage is not null)
    {
        <p class="weather-state weather-state--error" role="alert">@errorMessage</p>
    }
    else if (forecast is null)
    {
        <p class="weather-state">No hay un pronóstico disponible.</p>
    }
    else
    {
        <section class="current-weather weather-surface" data-condition="@forecast.Current.Summary" aria-labelledby="current-weather-heading">
            <div class="current-weather__details">
                <p class="current-weather__city">@forecast.City</p>
                <h2 id="current-weather-heading">Hoy · @FormatDate(forecast.Current.Date)</h2>
                <p class="current-weather__summary">@forecast.Current.Summary</p>
            </div>
            <div class="current-weather__icon"><WeatherIcon Summary="@forecast.Current.Summary" /></div>
            <div class="current-weather__temperature" aria-label="Temperatura actual">
                <span>@FormatTemperature(forecast.Current.TemperatureC)</span>
                <small>Se siente como @FormatTemperature(forecast.Current.FeelsLikeC)</small>
            </div>
            <dl class="current-weather__metrics">
                <div>
                    <dt>Humedad</dt>
                    <dd>@forecast.Current.HumidityPercentage%</dd>
                </div>
                <div>
                    <dt>Viento</dt>
                    <dd>@FormatMeasurement(forecast.Current.WindSpeedKph) km/h</dd>
                </div>
            </dl>
        </section>

        <section class="upcoming-weather" aria-labelledby="upcoming-weather-heading">
            <div class="upcoming-weather__heading">
                <h2 id="upcoming-weather-heading">Próximos días</h2>
                <p>Planea tu semana.</p>
            </div>
            <div class="forecast-grid">
                @foreach (var day in forecast.UpcomingDays)
                {
                    <article class="forecast-card weather-surface" data-condition="@day.Summary" @key="day.Date">
                        <p class="forecast-card__date">@FormatDate(day.Date)</p>
                        <div class="forecast-card__icon"><WeatherIcon Summary="@day.Summary" /></div>
                        <p class="forecast-card__summary">@day.Summary</p>
                        <p class="forecast-card__temperatures">
                            <span><small>Máx.</small> @FormatTemperature(day.MaximumTemperatureC)</span>
                            <span><small>Mín.</small> @FormatTemperature(day.MinimumTemperatureC)</span>
                        </p>
                        <p class="forecast-card__precipitation">
                            Lluvia: @day.PrecipitationProbabilityPercentage% · @FormatMeasurement(day.PrecipitationMillimeters) mm
                        </p>
                    </article>
                }
            </div>
        </section>

        <p class="weather-attribution">Datos meteorológicos por <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo.com</a>.</p>
    }
</section>
